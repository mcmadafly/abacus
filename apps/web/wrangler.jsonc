{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abacus",
  // Built by the Astro Cloudflare adapter from src/worker.ts (workerEntryPoint).
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serve Astro's built static assets (and /abacus.js) from the same Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // D1: accounts, sites, daily rollups, digest subscriptions.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abacus-db",
      "database_id": "REPLACE_WITH_REAL_D1_ID",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],

  // KV for Astro's built-in sessions (required by the adapter on Workers).
  // For local dev platformProxy provisions this automatically; for production
  // create a namespace (`wrangler kv namespace create SESSION`) and paste its id.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "REPLACE_WITH_REAL_KV_ID"
    }
  ],

  // Analytics Engine: high-volume raw pageview/event ingestion.
  "analytics_engine_datasets": [
    {
      "binding": "AE",
      "dataset": "abacus_events"
    }
  ],

  // Nightly digest at 06:00 UTC.
  "triggers": {
    "crons": ["0 6 * * *"]
  },

  // Non-secret vars. Secrets (CLERK_SECRET_KEY, RESEND_API_KEY,
  // CF_AE_API_TOKEN, VISITOR_HASH_SALT) come from .dev.vars / `wrangler secret put`.
  "vars": {
    "CF_ACCOUNT_ID": ""
  }
}
