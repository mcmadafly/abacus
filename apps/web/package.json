{
  "name": "@abacus/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "typecheck": "astro check",
    "db:migrate": "wrangler d1 migrations apply abacus-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply abacus-db --remote",
    "db:seed": "wrangler d1 execute abacus-db --local --file=./db/seed.sql",
    "db:demo": "wrangler d1 execute abacus-db --local --file=./db/demo.sql",
    "db:demo:remote": "wrangler d1 execute abacus-db --remote --file=./db/demo.sql"
  },
  "dependencies": {
    "@abacus/db": "workspace:*",
    "@astrojs/cloudflare": "^12.6.0",
    "@clerk/astro": "^2.5.0",
    "astro": "^6.0.0",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.38.3",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250121.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
