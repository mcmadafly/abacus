---
import type { Site } from "@abacus/db";
import { PLAN_LABEL, isPaid, isUnlimited, type PlanId } from "../lib/plans";

interface Props {
  sites: Site[];
  /** Id of the active site, "demo", or "overview" for the summary page. */
  activeId?: string;
  /** Whole days left in the feature trial (0 = lapsed). */
  daysLeft: number;
  plan?: PlanId;
  /** Pageviews used this month vs included quota (paid accounts only). */
  usage?: { used: number; included: number } | null;
  /** Site to preview the daily digest for (the active or first owned site). */
  previewSiteId?: string;
}
const {
  sites,
  activeId,
  daysLeft,
  plan = "free",
  usage,
  previewSiteId,
} = Astro.props;
const multi = sites.length > 1;
const paid = isPaid(plan);
const compact = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n);
const usagePct = usage
  ? Math.min(100, Math.round((usage.used / usage.included) * 100))
  : 0;
const over = usage ? usage.used > usage.included : false;
---

<aside class="dside appside">
  {
    multi && (
      <>
        <div class="dside__label">Overview</div>
        <a href="/app" class={`dnav${activeId === "overview" ? " is-active" : ""}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
          </svg>
          <span class="appside__dom">All sites</span>
        </a>
      </>
    )
  }

  <div class="dside__label">Your sites</div>
  {sites.length === 0 && <p class="appside__empty">No sites yet.</p>}
  {
    sites.map((s) => (
      <a
        href={`/app/${s.id}`}
        class={`dnav${s.id === activeId ? " is-active" : ""}`}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
        </svg>
        <span class="appside__dom">{s.domain}</span>
        {s.id === activeId && <span class="live">Live</span>}
      </a>
    ))
  }

  <div class="dside__label">Explore</div>
  <a href="/app/demo" class={`dnav${activeId === "demo" ? " is-active" : ""}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
    <span class="appside__dom">Live demo</span>
  </a>
  <a href="/app/new" class="dnav">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path d="M12 5v14M5 12h14" />
    </svg>
    <span class="appside__dom">Add site</span>
  </a>
  {
    previewSiteId && (
      <form method="POST" action="/app/preview-digest" class="appside__digest">
        <input type="hidden" name="site" value={previewSiteId} />
        <p class="appside__digesttitle">Daily digest</p>
        <p class="appside__digesttext">
          Preview tomorrow's email with today's stats.
        </p>
        <button type="submit" class="appside__digestbtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
          Email me a preview
        </button>
      </form>
    )
  }

  <div class="appside__foot">
    {
      paid ? (
        <>
          {usage && (
            <div class="appside__usage">
              <div class="appside__usagetop">
                <span>{compact(usage.used)} / {compact(usage.included)}</span>
                <span class="appside__usagecap">views · mo</span>
              </div>
              <div class="appside__bar">
                <i
                  class={over ? "is-over" : ""}
                  style={`width:${Math.max(2, usagePct)}%`}
                />
              </div>
              {over && (
                <p class="appside__over">Over quota — overage billed at $0.50/1k</p>
              )}
            </div>
          )}
          <p class="appside__trial">{PLAN_LABEL[plan]} plan · active</p>
          {
            !isUnlimited(plan) && (
              <a href="/app/billing" class="appside__upgrade appside__upgrade--manage">
                Manage billing
              </a>
            )
          }
        </>
      ) : (
        <>
          {daysLeft > 0 ? (
            <p class="appside__trial">
              {daysLeft} day{daysLeft === 1 ? "" : "s"} left in your trial
            </p>
          ) : (
            <p class="appside__trial appside__trial--ended">
              Trial ended · Free plan
            </p>
          )}
          <a href="/upgrade" class="appside__upgrade">
            Upgrade <span class="arrow">↑</span>
          </a>
        </>
      )
    }
  </div>
</aside>
