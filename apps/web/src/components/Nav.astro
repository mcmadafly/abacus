---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { SignedIn, UserButton } from "@clerk/astro/components";
import { clerkAppearance } from "../lib/clerkAppearance";
import { START_HREF, WAITLIST } from "../lib/site";
---

<header class="nav" id="nav">
  <div class="wrap nav__inner">
    <a class="brand" href="/" aria-label="Abacus home">
      <span class="brand__mark"><BrandMark /></span>
      <span class="brand__name">Abacus</span>
    </a>
    <nav class="nav__links">
      <a href="/#features">Features</a>
      <a href="/#how">How it works</a>
      <a href="/#demo">Live demo</a>
      <a href="/#pricing">Pricing</a>
    </nav>
    <div class="nav__right">
      <ThemeToggle />
      {
        WAITLIST ? (
          <a href={START_HREF} class="btn btn--dark">
            Start free <span class="arrow">→</span>
          </a>
        ) : (
          <div class="nav__auth">
            {/* Signed out (default, server-rendered → no flash for the common case) */}
            <div class="nav__signed-out">
              <a href="/sign-in" class="nav__login">
                Sign in
              </a>
              <a href="/sign-up" class="btn btn--dark">
                Start free <span class="arrow">→</span>
              </a>
            </div>
            {/* Signed in (hydrates client-side; reveals when a session is present,
                which then hides the signed-out CTAs via the :has() rule below) */}
            <SignedIn isStatic class="nav__signed-in">
              <UserButton appearance={clerkAppearance} />
              <a href="/app" class="btn btn--dark">
                Dashboard <span class="arrow">→</span>
              </a>
            </SignedIn>
          </div>
        )
      }
    </div>
  </div>
</header>

<script is:inline>
  // nav gains a hairline border + stronger blur once scrolled
  (function () {
    const nav = document.getElementById("nav");
    if (!nav) return;
    const onScroll = () => nav.classList.toggle("scrolled", window.scrollY > 12);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
