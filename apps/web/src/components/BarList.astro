---
import type { TopItem } from "@abacus/db";

interface Props {
  title: string;
  label: string;
  items: TopItem[];
}
const { title, label, items } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.count));
---

<div class="rounded-xl border border-[var(--line)] p-5">
  <div
    class="mb-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wide text-[var(--ink-mute)]"
  >
    <span>{title}</span>
    <span>{label}</span>
  </div>
  {
    items.length === 0 ? (
      <p class="py-6 text-center text-sm text-[var(--ink-mute)]">No data yet</p>
    ) : (
      <ul class="space-y-1">
        {items.map((i) => (
          <li class="relative">
            <div
              class="absolute inset-y-0 left-0 rounded bg-[var(--iris-wash)]"
              style={`width:${Math.max(4, (i.count / max) * 100)}%`}
            />
            <div class="relative flex items-center justify-between px-2 py-1.5 text-sm">
              <span class="truncate">{i.name || "—"}</span>
              <span class="ml-3 tabular-nums text-[var(--ink-mute)]">
                {i.count.toLocaleString()}
              </span>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</div>
