---
// Light/dark switcher. The actual toggle handler + pre-paint theme init live
// once in Layout.astro; this is just the button (safe to render many times).
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Toggle dark mode"
  title="Toggle dark mode"
>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path>
  </svg>
</button>
