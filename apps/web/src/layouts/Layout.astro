---
import "../styles/global.css";
import { SITE_URL, GITHUB_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Page-specific JSON-LD (e.g. a BlogPosting). Merged with the site-wide
   *  Organization + WebSite schema. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Optional path to a markdown alternate of this page (for LLMs/crawlers). */
  markdownHref?: string;
}

const {
  title = "Abacus — privacy-first analytics, delivered to your inbox",
  description = "Abacus is a featherweight, cookie-free analytics tool that respects your visitors — and emails you a clean, readable report every morning.",
  jsonLd,
  markdownHref,
} = Astro.props;

// Canonical URL: always the production origin + this page's path (no query
// string), so search engines and LLMs de-dupe to one address.
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

// Site-wide structured data, plus any page-specific schema.
const structuredData: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Abacus",
    url: SITE_URL,
    logo: `${SITE_URL}/brandmark.png`,
    description:
      "Privacy-first web analytics with a daily email digest. Cookie-free, no personal data, open source.",
    sameAs: [GITHUB_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Abacus",
    url: SITE_URL,
  },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <!-- Set the theme before first paint (default: dark) to avoid a flash. -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("abacus-theme");
          document.documentElement.dataset.theme = t === "light" ? "light" : "dark";
        } catch (e) {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <!-- Record the viewer's timezone in a cookie so the dashboard can show days
         in their local time (not UTC). One reload on the first /app visit lets
         the SSR pick it up. -->
    <script is:inline>
      (function () {
        try {
          var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
          if (!tz) return;
          var had = document.cookie.indexOf("abacus_tz=") !== -1;
          document.cookie =
            "abacus_tz=" +
            encodeURIComponent(tz) +
            ";path=/;max-age=31536000;samesite=lax";
          if (
            !had &&
            location.pathname.indexOf("/app") === 0 &&
            !sessionStorage.getItem("abacus_tz_set")
          ) {
            sessionStorage.setItem("abacus_tz_set", "1");
            location.reload();
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {
      markdownHref && (
        <link
          rel="alternate"
          type="text/markdown"
          href={markdownHref}
          title="Markdown version"
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Abacus" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og.jpg", Astro.url).href} />
    {
      structuredData.map((schema) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      ))
    }
    <!-- Abacus eats its own dog food: the marketing site is tracked by Abacus
         into the "abacuslytics.com" site in the dashboard. We skip the
         app/auth/api routes so logged-in usage doesn't inflate marketing stats.
         (No data-allow-local: the absolute src means local dev would otherwise
         report into production — so the tracker stays off on localhost.) -->
    <script
      is:inline
      defer
      data-domain="abacuslytics.com"
      data-exclude="/app/*,/sign-in/*,/sign-up/*,/api/*"
      src="https://abacuslytics.com/abacus.js"></script>
  </head>
  <body>
    <slot />
    <!-- One delegated handler flips + persists the theme for every toggle. -->
    <script is:inline>
      document.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-theme-toggle]");
        if (!btn) return;
        var next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("abacus-theme", next);
        } catch (err) {}
      });
    </script>
  </body>
</html>
