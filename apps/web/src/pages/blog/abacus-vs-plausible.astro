---
import Content from "../../layouts/Content.astro";
import { Content as Body } from "../../articles/abacus-vs-plausible.md";
import { getPost, plainHeading } from "../../lib/posts";
import { START_HREF, SITE_URL } from "../../lib/site";

const post = getPost("abacus-vs-plausible");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: plainHeading(post),
  description: post.dek,
  datePublished: post.iso,
  dateModified: post.iso,
  url: `${SITE_URL}/blog/${post.slug}`,
  author: { "@type": "Organization", name: "Abacus", url: SITE_URL },
  publisher: {
    "@type": "Organization",
    name: "Abacus",
    logo: { "@type": "ImageObject", url: `${SITE_URL}/brandmark.png` },
  },
};
---

<Content
  title={post.title}
  description={post.dek}
  eyebrow="Comparison"
  heading={post.heading}
  sub={post.dek}
  meta={`${post.date} · ${post.readingTime}`}
  jsonLd={jsonLd}
  markdownHref={`/blog/${post.slug}.md`}
>
  <Body />

  <div class="article__foot">
    <a href={START_HREF} class="btn btn--dark">Start free <span class="arrow">→</span></a>
    <a href="/#demo" class="btn btn--ghost">See the live demo</a>
  </div>
</Content>
