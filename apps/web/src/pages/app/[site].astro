---
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.astro";
import AppSidebar from "../../components/AppSidebar.astro";
import BarList from "../../components/BarList.astro";
import { createDb } from "@abacus/db";
import {
  DEMO_SITE_ID,
  getAccount,
  getDemoSite,
  getSite,
  listSites,
  trialDaysLeft,
} from "../../lib/account";
import { resolveUser } from "../../lib/auth";
import { getStatsWithDelta, pctDelta } from "../../lib/query";
import { accountUsage } from "../../lib/usage";
import { safeTz, shiftDay, todayInTz } from "../../lib/tz";

export const prerender = false;

const me = await resolveUser(Astro.locals);
if (!me) return Astro.redirect("/sign-in");
const { userId } = me;

const env = Astro.locals.runtime.env;
const db = createDb(env.DB);

const siteId = Astro.params.site!;
// The demo site is public/read-only — viewable by any signed-in user; all other
// sites are scoped to their owner.
const isDemo = siteId === DEMO_SITE_ID;
const site = isDemo ? await getDemoSite(db) : await getSite(db, userId, siteId);
if (!site) return Astro.redirect("/app");

// Sidebar nav: the signed-in user's own sites (the demo is listed separately).
const mySites = await listSites(db, userId);
const account = await getAccount(db, userId);
const plan = account?.plan as "free" | "growth" | "scale" | "unlimited" | undefined;
const daysLeft = trialDaysLeft(account);
const usage = await accountUsage(env, account, mySites.map((s) => s.id));
const digestStatus = Astro.url.searchParams.get("digest");

// Range: ?range=7|30|90 (days), default 7. Dates use the viewer's timezone
// (from the abacus_tz cookie) so "today" matches their local day, not UTC.
const range = Number(Astro.url.searchParams.get("range")) || 7;
const days = [7, 30, 90].includes(range) ? range : 7;

const tz = safeTz(Astro.cookies.get("abacus_tz")?.value);
const endDay = todayInTz(tz);
const startDay = shiftDay(endDay, -(days - 1));

const stats = await getStatsWithDelta(env, site.id, startDay, endDay, days, tz);
const hasData = stats.pageviews > 0;

// Build complete, zero-filled per-day series so the chart + sparklines always
// span the full range (the AE query only returns days that had traffic).
const byDay = new Map(stats.byDay.map((d) => [d.date, d]));
const dayLabel = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
type Day = { date: string; label: string; pageviews: number; visitors: number };
const series: Day[] = [];
for (let i = 0; i < days; i++) {
  const iso = shiftDay(startDay, i);
  const d = byDay.get(iso);
  series.push({
    date: iso,
    label: dayLabel(iso),
    pageviews: d?.pageviews ?? 0,
    visitors: d?.visitors ?? 0,
  });
}
// 5 evenly-spaced x-axis ticks.
const axisIdx = Array.from({ length: 5 }, (_, i) =>
  Math.min(series.length - 1, Math.round(((series.length - 1) * i) / 4)),
);

// A sparkline / delta is only meaningful once there are a few days of data —
// below that we show blank placeholder bars instead of a misleading spike.
const daysWithData = series.filter(
  (s) => s.pageviews > 0 || s.visitors > 0,
).length;
const enoughTrend = daysWithData >= 3;

const compact = (n: number) =>
  n >= 1000 ? `${(n / 1000).toFixed(n >= 10000 ? 0 : 1)}k` : String(n);
const vpv = (pv: number, vis: number) => (vis ? pv / vis : 0);
const fmtDelta = (d: number) => `${d >= 0 ? "↑" : "↓"} ${Math.abs(d)}%`;

const sparks = {
  visitors: series.map((s) => s.visitors),
  pageviews: series.map((s) => s.pageviews),
  vpv: series.map((s) => Math.round(vpv(s.pageviews, s.visitors) * 10) / 10),
};

// Stat cards carry a metric key (for the sparkline), a value, and a
// period-over-period delta vs the immediately preceding window.
const cards = [
  {
    metric: "visitors" as const,
    label: "Unique visitors",
    value: compact(stats.visitors),
    delta: pctDelta(stats.prev.visitors, stats.visitors),
  },
  {
    metric: "pageviews" as const,
    label: "Pageviews",
    value: compact(stats.pageviews),
    delta: pctDelta(stats.prev.pageviews, stats.pageviews),
  },
  {
    metric: "vpv" as const,
    label: "Views / visitor",
    value: vpv(stats.pageviews, stats.visitors).toFixed(1),
    delta: pctDelta(
      vpv(stats.prev.pageviews, stats.prev.visitors),
      vpv(stats.pageviews, stats.visitors),
    ),
  },
];

const snippet = `<script defer data-domain="${site.domain}"\n  src="${Astro.url.origin}/abacus.js"></script>`;
const chartData = JSON.stringify({
  labels: series.map((s) => s.label),
  pageviews: series.map((s) => s.pageviews),
  sparks,
});
---

<Layout title={`${site.domain} — Abacus`}>
  <AppHeader crumb={site.domain} plan={plan} />

  <div class="appshell">
    <AppSidebar
      sites={mySites}
      activeId={isDemo ? "demo" : site.id}
      daysLeft={daysLeft}
      plan={plan}
      usage={usage}
      previewSiteId={isDemo ? mySites[0]?.id : site.id}
    />

    <!-- main -->
    <main class="dmain appmain">
      {
        digestStatus === "sent" && (
          <div class="appnote appnote--ok">
            ✓ Digest preview sent to {me.email}.
          </div>
        )
      }
      {
        digestStatus === "error" && (
          <div class="appnote appnote--err">
            Couldn't send the digest preview — please try again shortly.
          </div>
        )
      }
      {
        digestStatus === "unconfigured" && (
          <div class="appnote appnote--err">
            Email delivery isn't configured yet (Resend). Add a real RESEND_API_KEY
            to enable digest previews.
          </div>
        )
      }
      {
        isDemo && (
          <div class="appdemo">
            <div>
              <p class="appdemo__tag">● Live demo</p>
              <p class="appdemo__txt">
                This is Abacus tracking its own site — exactly what your dashboard
                looks like. Add your domain to start measuring yours.
              </p>
            </div>
            <a href="/app/new" class="appbtn">Add your site →</a>
          </div>
        )
      }

      <div class="dtop">
        <div class="dhello">{site.domain}</div>
        <div class="appranges">
          {
            [7, 30, 90].map((d) => (
              <a
                href={`?range=${d}`}
                class={`appranges__btn${d === days ? " is-active" : ""}`}
              >
                {d}d
              </a>
            ))
          }
        </div>
      </div>
      <p class="dhello__sub">
        {
          stats.source === "d1"
            ? "Showing rolled-up data (live Analytics Engine not configured locally)."
            : "Live data from Analytics Engine."
        }
      </p>

      {
        !hasData && (
          <div class="appsnippet">
            <h2 class="appsnippet__h">Waiting for your first visit</h2>
            <p class="appsnippet__p">
              Add this snippet to the <code>&lt;head&gt;</code> of {site.domain}.
              Data appears within seconds of your first pageview.
            </p>
            <pre class="appsnippet__pre"><code>{snippet}</code></pre>
          </div>
        )
      }

      <!-- stat strip -->
      <div class="dstats appstats">
        {
          cards.map((c) => (
            <div class="dstat">
              <div class="dstat__top">
                <span class="dstat__label">{c.label}</span>
                {enoughTrend ? (
                  <span class="dstat__spark">
                    <canvas data-spark={c.metric} width="46" height="18" />
                  </span>
                ) : (
                  <span class="dstat__spark dspark-ph" aria-hidden="true">
                    {Array.from({ length: 9 }).map(() => (
                      <i />
                    ))}
                  </span>
                )}
              </div>
              <div class="dstat__val">{c.value}</div>
              {enoughTrend ? (
                <div class={`dstat__delta${c.delta < 0 ? " dn" : ""}`}>
                  {fmtDelta(c.delta)} vs prev {days}d
                </div>
              ) : (
                <div class="dstat__delta dstat__delta--muted">
                  Collecting data…
                </div>
              )}
            </div>
          ))
        }
        <div class="dstat">
          <div class="dstat__top">
            <span class="dstat__label">Range</span>
          </div>
          <div class="dstat__val">{days}d</div>
        </div>
      </div>

      <!-- pageviews trend -->
      <div class="dchart">
        <div class="dchart__head">
          <div class="dchart__metric">
            <span class="dchart__num">{compact(stats.pageviews)}</span>
            <span class="dchart__cap">Pageviews · last {days} days</span>
          </div>
          <div class="dchart__legend">
            <span class="dchart__tag on">
              <span class="swat"></span>Pageviews
            </span>
          </div>
        </div>
        <div class="dchart__plot">
          {
            hasData ? (
              <canvas id="trendChart"></canvas>
            ) : (
              <p class="appchart__empty">No data yet</p>
            )
          }
        </div>
        <div class="dchart__axis">
          {axisIdx.map((idx) => <span>{series[idx]?.label}</span>)}
        </div>
      </div>

      <!-- breakdowns -->
      <div class="appbreak">
        <BarList title="Top pages" label="Pageviews" items={stats.topPages} />
        <BarList title="Top sources" label="Pageviews" items={stats.topReferrers} />
        <BarList title="Countries" label="Pageviews" items={stats.topCountries} />
      </div>
    </main>
  </div>

  {
    hasData && (
      <script
        type="application/json"
        id="trend-data"
        set:html={chartData}
      />
    )
  }
</Layout>

{
  hasData && (
    <script>
      import {
        Chart,
        LineController,
        LineElement,
        PointElement,
        BarController,
        BarElement,
        LinearScale,
        CategoryScale,
        Filler,
        Tooltip,
      } from "chart.js";

      Chart.register(
        LineController,
        LineElement,
        PointElement,
        BarController,
        BarElement,
        LinearScale,
        CategoryScale,
        Filler,
        Tooltip,
      );

      const el = document.getElementById("trend-data");
      const data = JSON.parse(el?.textContent || "{}") as {
        labels: string[];
        pageviews: number[];
        sparks: Record<string, number[]>;
      };

      // Per-metric sparklines in the stat strip.
      document.querySelectorAll<HTMLCanvasElement>("canvas[data-spark]").forEach((cv) => {
        const arr = data.sparks?.[cv.dataset.spark || ""] || [];
        const colors = arr.map((_, i) =>
          i === arr.length - 1 ? "#7c5cff" : "rgba(124,92,255,0.45)",
        );
        new Chart(cv.getContext("2d")!, {
          type: "bar",
          data: {
            labels: arr.map(() => ""),
            datasets: [
              {
                data: arr,
                backgroundColor: colors,
                borderRadius: 2,
                barPercentage: 0.72,
                categoryPercentage: 0.86,
              },
            ],
          },
          options: {
            responsive: false,
            animation: false,
            plugins: { legend: { display: false }, tooltip: { enabled: false } },
            scales: {
              x: { display: false },
              y: { display: false, beginAtZero: true },
            },
          },
        });
      });

      const canvas = document.getElementById("trendChart") as HTMLCanvasElement | null;
      if (canvas) {
        const ctx = canvas.getContext("2d")!;
        const grad = ctx.createLinearGradient(0, 0, 0, 168);
        grad.addColorStop(0, "rgba(91,70,229,0.30)");
        grad.addColorStop(1, "rgba(91,70,229,0)");
        new Chart(ctx, {
          type: "line",
          data: {
            labels: data.labels,
            datasets: [
              {
                data: data.pageviews,
                borderColor: "#5b46e5",
                borderWidth: 2.2,
                backgroundColor: grad,
                fill: true,
                tension: 0.4,
                pointRadius: 0,
                pointHoverRadius: 4,
                pointHoverBackgroundColor: "#fff",
                pointHoverBorderColor: "#5b46e5",
                pointHoverBorderWidth: 2.4,
              },
            ],
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 450 },
            interaction: { intersect: false, mode: "index" },
            plugins: {
              legend: { display: false },
              tooltip: {
                displayColors: false,
                backgroundColor: "rgba(20,18,40,0.92)",
                padding: 8,
                callbacks: {
                  title: (items) => items[0]?.label ?? "",
                  label: (c) => `${(c.parsed.y ?? 0).toLocaleString()} pageviews`,
                },
              },
            },
            scales: {
              x: { display: false },
              y: { display: false, beginAtZero: true, grace: "12%" },
            },
          },
        });
      }
    </script>
  )
}
