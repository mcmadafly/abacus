---
import Layout from "../../layouts/Layout.astro";
import AppHeader from "../../components/AppHeader.astro";
import BarList from "../../components/BarList.astro";
import { createDb } from "@abacus/db";
import { DEMO_SITE_ID, getDemoSite, getSite } from "../../lib/account";
import { resolveUser } from "../../lib/auth";
import { getStats } from "../../lib/query";

export const prerender = false;

const me = await resolveUser(Astro.locals);
if (!me) return Astro.redirect("/sign-in");
const { userId } = me;

const env = Astro.locals.runtime.env;
const db = createDb(env.DB);

const siteId = Astro.params.site!;
// The demo site is public/read-only — viewable by any signed-in user; all other
// sites are scoped to their owner.
const isDemo = siteId === DEMO_SITE_ID;
const site = isDemo
  ? await getDemoSite(db)
  : await getSite(db, userId, siteId);
if (!site) return Astro.redirect("/app");

// Range: ?range=7|30|90 (days), default 7.
const range = Number(Astro.url.searchParams.get("range")) || 7;
const days = [7, 30, 90].includes(range) ? range : 7;

const today = new Date();
const endDay = today.toISOString().slice(0, 10);
const startDate = new Date(today);
startDate.setUTCDate(startDate.getUTCDate() - (days - 1));
const startDay = startDate.toISOString().slice(0, 10);

const stats = await getStats(env, site.id, startDay, endDay);

const maxDay = Math.max(1, ...stats.byDay.map((d) => d.pageviews));
const hasData = stats.pageviews > 0;

const snippet = `<script defer data-domain="${site.domain}"\n  src="${Astro.url.origin}/abacus.js"></script>`;
---

<Layout title={`${site.domain} — Abacus`}>
  <AppHeader crumb={site.domain} />
  <main class="mx-auto w-full max-w-6xl flex-1 px-6 py-10">
    {
      isDemo && (
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[var(--line)] bg-[var(--iris-wash)] p-5">
          <div>
            <p class="font-mono text-xs uppercase tracking-wide text-abacus-700">
              ● Live demo
            </p>
            <p class="mt-1 text-sm text-[var(--ink-soft)]">
              This is Abacus tracking its own site — exactly what your own
              dashboard will look like. Add your domain to start measuring yours.
            </p>
          </div>
          <a
            href="/app"
            class="rounded-lg bg-abacus-600 px-4 py-2 text-sm font-medium text-white hover:bg-abacus-700"
          >
            Add your site →
          </a>
        </div>
      )
    }
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h1 class="font-serif text-3xl font-medium tracking-tight">{site.domain}</h1>
        <p class="mt-1 text-sm text-[var(--ink-mute)]">
          {
            stats.source === "d1"
              ? "Showing rolled-up data (live Analytics Engine not configured locally)."
              : "Live data from Analytics Engine."
          }
        </p>
      </div>
      <div class="flex gap-1 rounded-lg border border-[var(--line)] p-1 text-sm">
        {
          [7, 30, 90].map((d) => (
            <a
              href={`?range=${d}`}
              class={`rounded-md px-3 py-1 ${d === days ? "bg-abacus-600 text-white" : "text-[var(--ink-soft)] hover:bg-[var(--bg-2)]"}`}
            >
              {d}d
            </a>
          ))
        }
      </div>
    </div>

    {
      !hasData && (
        <div class="mt-8 rounded-xl border border-dashed border-[var(--line)] p-8">
          <h2 class="font-serif text-xl font-medium">Waiting for your first visit</h2>
          <p class="mt-1 text-sm text-[var(--ink-soft)]">
            Add this snippet to the <code class="rounded bg-[var(--bg-2)] px-1">
              &lt;head&gt;
            </code>{" "}
            of {site.domain}. Data appears within seconds of your first pageview.
          </p>
          <pre class="mt-4 overflow-x-auto rounded-lg bg-[var(--slate)] p-4 text-xs text-gray-100"><code>{snippet}</code></pre>
        </div>
      )
    }

    <!-- Totals -->
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-xl border border-[var(--line)] p-5">
        <p class="text-sm text-[var(--ink-mute)]">Unique visitors</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">
          {stats.visitors.toLocaleString()}
        </p>
      </div>
      <div class="rounded-xl border border-[var(--line)] p-5">
        <p class="text-sm text-[var(--ink-mute)]">Pageviews</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">
          {stats.pageviews.toLocaleString()}
        </p>
      </div>
      <div class="rounded-xl border border-[var(--line)] p-5">
        <p class="text-sm text-[var(--ink-mute)]">Views / visitor</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">
          {stats.visitors ? (stats.pageviews / stats.visitors).toFixed(1) : "0.0"}
        </p>
      </div>
      <div class="rounded-xl border border-[var(--line)] p-5">
        <p class="text-sm text-[var(--ink-mute)]">Range</p>
        <p class="mt-1 text-3xl font-bold tabular-nums">{days}d</p>
      </div>
    </div>

    <!-- Trend -->
    <div class="mt-4 rounded-xl border border-[var(--line)] p-5">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wide text-[var(--ink-mute)]">
        Pageviews over time
      </p>
      {
        stats.byDay.length === 0 ? (
          <p class="py-8 text-center text-sm text-[var(--ink-mute)]">No data yet</p>
        ) : (
          <div class="flex h-40 items-end gap-1">
            {stats.byDay.map((d) => (
              <div class="group flex flex-1 flex-col items-center justify-end">
                <div
                  class="w-full rounded-t bg-abacus-500/80 transition-colors group-hover:bg-abacus-600"
                  style={`height:${(d.pageviews / maxDay) * 100}%`}
                  title={`${d.date}: ${d.pageviews} pageviews`}
                />
              </div>
            ))}
          </div>
        )
      }
    </div>

    <!-- Breakdowns -->
    <div class="mt-4 grid gap-4 lg:grid-cols-3">
      <BarList title="Top pages" label="Pageviews" items={stats.topPages} />
      <BarList title="Top sources" label="Pageviews" items={stats.topReferrers} />
      <BarList title="Countries" label="Pageviews" items={stats.topCountries} />
    </div>
  </main>
</Layout>
